# ─── CyberForge GeoIP / IP-Intelligence configuration ─────────────────────────
# The GeoIP provider is fully configurable and never hard-coded in source.
#
# GEOIP_API_URL may contain the {ip} placeholder (recommended), e.g.:
#   https://ipapi.co/{ip}/json
#   https://ipapi.co/{ip}/json/?key=YOUR_KEY
#   https://ipqualityscore.com/api/json/ip/YOUR_KEY/{ip}
#   https://ipinfo.io/{ip}/json?token=YOUR_TOKEN
# Without a placeholder, the IP is appended as a query parameter (?ip=...).
#
# If left empty, the app continues to run: IP validation, classification and
# risk analysis work without geolocation; the UI shows "Geolocation unavailable".
GEOIP_API_URL=
GEOIP_API_KEY=
# Request timeout in seconds for GeoIP lookups (default 10, clamped 1-60).
GEOIP_TIMEOUT=10

# ─── Threat intelligence (AbuseIPDB) ─────────────────────────────────────────
# Enriches public IPs with reputation + infrastructure type (tor/proxy/
# datacenter/vps). Set ABUSEIPDB_API_KEY to enable. All lookups degrade
# gracefully (the pipeline runs without it). Get a free key at abuseipdb.com.
ABUSEIPDB_API_KEY=
# Optional override of the v2 check endpoint.
ABUSEIPDB_API_URL=
# How far back AbuseIPDB should look for reports (default 90).
ABUSEIPDB_MAX_AGE_DAYS=90
# Request timeout in seconds for threat-intel lookups (default 10, clamped 1-60).
THREAT_INTEL_TIMEOUT=10

# ─── Ingestion & alerting ────────────────────────────────────────────────────
# Run `python -m ingest.webhook_server` to start the real-time listener.
INGEST_HOST=0.0.0.0
INGEST_PORT=8080
# Optional bearer token protecting POST /analyze. Empty = no auth (local use).
INGEST_TOKEN=
# Sender policy filtering applied BEFORE any content processing.
SENDER_ALLOWLIST=
SENDER_DENYLIST=
# Optional HTTP target for high-risk alerts (e.g. Slack/Teams incoming webhook).
ALERT_WEBHOOK_URL=

# ─── Live authentication validation (SPF / DKIM / DMARC) ─────────────────────
# Re-verifies email authentication against DNS, rather than trusting the
# receiver's Authentication-Results header. Uses pyspf + dkimpy (requirements).
# No keys required; AUTH_VALIDATION_TIMEOUT bounds DNS lookups (default 8s).
AUTH_VALIDATION_TIMEOUT=8

# ─── Storage & compliance ────────────────────────────────────────────────────
# SQLite path for cases, campaigns, tracking tokens and the chain-of-custody log.
CASE_STORE_PATH=data/cases.db
# HMAC key for the tamper-evident audit log (change in production!).
COC_SECRET=coc-dev-secret-change-me

# ─── Active tracking (pixel + click redirects) ───────────────────────────────
# Run `python -m tracking.server` to start the interactive listener.
TRACKING_HOST=0.0.0.0
TRACKING_PORT=8081
# Public base used to build embeddable pixel / redirect URLs.
TRACKING_BASE_URL=http://localhost:8081
# Optional bearer token required for the analyst endpoints (/tokens, /hits).
TRACKING_API_TOKEN=
# Where tokens + interaction events are persisted (default: CASE_STORE_PATH).
TRACKING_DB_PATH=